{
	"name": "data-dashboard-iteration-react",
	"version": "1.0.0-alpha",
	"description": "A React-based data dashboard application with Tanstack.",
	"type": "module",
	"scripts": {
		"dev": "vite --port 3000",
		"start": "vite --port 3000",
		"build": "vite build && tsc",
