		"@tanstack/react-router": "^1.130.2",
		"@tanstack/react-router-devtools": "^1.130.2",
		"@tanstack/react-table": "^8.21.3",
		"echarts": "^5.6.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"tailwindcss": "^4.1.11",
		"zod": "^4.0.13"
	},
	"devDependencies": {
